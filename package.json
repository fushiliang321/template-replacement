    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-legacy": "^8.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-oxlint": "^1.73.0",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.73.0",
    "terser": "^5.49.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
